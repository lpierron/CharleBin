<?xml version="1.0"?>
<ruleset name="PrivateBin PHPMD rule set"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0
                     http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="
                     http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>
        PrivateBin custom rule set
    </description>

    <!-- Exclude vendor and test directories -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tst/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <!-- Import unused code rules but exclude unused formal parameters -->
    <rule ref="rulesets/unusedcode.xml">
        <exclude name="UnusedFormalParameter" />
    </rule>

    <!-- Cyclomatic complexity with a more reasonable threshold -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <priority>3</priority>
        <properties>
            <property name="reportLevel" value="50" />
        </properties>
    </rule>

</ruleset>
